# Local browser staging. Copy this file to `.env.staging` and replace every
# placeholder. Never commit the completed `.env.staging` file.
ECHO_ENVIRONMENT=staging
NODE_ENV=development
LOG_LEVEL=info

# Local staging group
LOCAL_CHAT_PORT=3100
LOCAL_CHAT_CONVERSATION_ID=echo-local-staging

# Supabase staging project. Use the server-side service-role key, not an anon key.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Pinecone staging index. Its dimension must match config/models.yaml.
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=YOUR_STAGING_INDEX_NAME

# Model credentials referenced by config/models.yaml.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
COHERE_API_KEY=YOUR_COHERE_API_KEY
AI_MODEL_CONFIG_PATH=config/models.yaml
AGENT_CONFIG_PATH=config/agent.yaml

# Google Sheets staging data source and ignored service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=secrets/google-service-account.json
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Required shared application settings. Local browser staging does not start
# WhatsApp, but the validated application configuration still requires them.
WHATSAPP_SESSION_ID=echo-local-staging
WHATSAPP_GROUP_ID=echo-local-staging
WHATSAPP_ALLOW_ALL_GROUPS=false
WHATSAPP_LOG_GROUP_IDS=false
TOP_K=8
